default_platform(:android)

platform :android do
  desc "Upload the release bundle to Google Play"
  lane :upload do |options|
    aab_path = options[:aab_path] || ENV.fetch("PLAY_AAB_PATH", "app/build/outputs/bundle/release/app-release.aab")
    track = options[:track] || ENV.fetch("PLAY_TRACK", "internal")
    release_status = options[:release_status] || ENV.fetch("PLAY_RELEASE_STATUS", "completed")

    upload_to_play_store(
      aab: aab_path,
      track: track,
      release_status: release_status,
      package_name: "com.droidrops.app",
      metadata_path: "fastlane/metadata/android",
      json_key: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_apk: true,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end
end
