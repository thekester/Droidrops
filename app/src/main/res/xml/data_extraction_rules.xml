<?xml version="1.0" encoding="utf-8"?>
<!-- Keep session tokens and Keystore-encrypted credentials out of backups and transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="account_credentials.xml" />
        <exclude domain="database" path="readrops-db" />
        <exclude domain="database" path="readrops-db-wal" />
        <exclude domain="database" path="readrops-db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="account_credentials.xml" />
        <exclude domain="database" path="readrops-db" />
        <exclude domain="database" path="readrops-db-wal" />
        <exclude domain="database" path="readrops-db-shm" />
    </device-transfer>
</data-extraction-rules>
