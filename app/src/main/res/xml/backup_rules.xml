<?xml version="1.0" encoding="utf-8"?>
<!--
    Credentials are encrypted using a Keystore key that is not backed up, so the encrypted
    preferences file cannot be restored independently. The Room database also contains session
    tokens. Exclude both stores and SQLite side files from backup and device transfer.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="account_credentials.xml" />
    <!-- The database contains session tokens; keep all app data out of device backups. -->
    <exclude domain="database" path="readrops-db" />
    <exclude domain="database" path="readrops-db-wal" />
    <exclude domain="database" path="readrops-db-shm" />
</full-backup-content>
